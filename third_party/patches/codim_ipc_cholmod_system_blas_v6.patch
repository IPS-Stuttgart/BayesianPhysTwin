diff --git a/CMake/suitesparse.cmake b/CMake/suitesparse.cmake
--- a/CMake/suitesparse.cmake
+++ b/CMake/suitesparse.cmake
@@ -42,9 +42,16 @@
-if (NOT APPLE)
-    include(mkl)
-endif()
+set(SYSTEM_BLAS_LIBRARY "" CACHE FILEPATH "Absolute path to the BLAS library")
+set(SYSTEM_LAPACK_LIBRARY "" CACHE FILEPATH "Absolute path to the LAPACK library")
+if(NOT EXISTS "${SYSTEM_BLAS_LIBRARY}")
+    message(FATAL_ERROR "SYSTEM_BLAS_LIBRARY must name an existing library")
+endif()
+if(NOT EXISTS "${SYSTEM_LAPACK_LIBRARY}")
+    message(FATAL_ERROR "SYSTEM_LAPACK_LIBRARY must name an existing library")
+endif()
 if(NOT TARGET blas)
     add_library(blas INTERFACE IMPORTED GLOBAL)
+    target_link_libraries(blas INTERFACE "${SYSTEM_BLAS_LIBRARY}")
 endif()
 if(NOT TARGET lapack)
     add_library(lapack INTERFACE IMPORTED GLOBAL)
+    target_link_libraries(lapack INTERFACE "${SYSTEM_LAPACK_LIBRARY}")
 endif()
