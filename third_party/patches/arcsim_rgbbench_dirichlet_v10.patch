+void NodeHandle::apply_kinematic (double t, double dt) {
+    if (!kinematic || !active(t))
+        return;
+    Vec3 x = target(t);
+    if (dt > 0) {
+        double previous_time = t - dt;
+        if (previous_time < start_time)
+            previous_time = start_time;
+        node->v = (x - target(previous_time))/dt;
+    } else {
+        node->v = Vec3(0);
+    }
+    node->x = x;
+    node->acceleration = Vec3(0);
+}
