    "permutation_seed": 20260902,
    "covariance_eigenvalue_floor": 1e-06
  },
  "comparisons": [
    "persistence",
    "last_delta",
    "state_only_bayesian_full_covariance",
    "action_conditioned_bayesian_diagonal_covariance",
