    "minimum_true_vs_permuted_action_nll_gain_per_dimension": 0.0,
    "maximum_action_rmse_ratio_to_persistence": 1.05,
    "minimum_normalized_joint_nees": 0.5,
    "maximum_normalized_joint_nees": 2.0,
    "minimum_marginal_coverage": 0.8,
    "maximum_marginal_coverage": 0.98
  },
  "statistical_scope": "Single-episode source competence diagnostic only. Frames are temporally dependent observations nested within one episode and are not independent experimental units.",
  "claim_boundary": "This protocol may qualify source robot-to-tactile predictive competence and dependence-preserving uncertainty. It cannot establish physical-parameter identifiability, metric geometry, cross-action transport, target benefit, independent-object generalization, Causal4D decision value, safety, or an ICRA paper claim."
