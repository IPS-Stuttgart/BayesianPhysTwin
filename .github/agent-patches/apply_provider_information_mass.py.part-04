e_sample_cap=False,
    )

    assert np.sum(weight) == pytest.approx(40.96)
    assert np.sum(provider_weight) == pytest.approx(64.0)


def test_prior_aware_layout_uses_provider_final_group_power() -> None:
    count = 100
    args = (
        ("group",) * count,
        np.ones(count),
        np.ones(count),
        np.full(count, 0.64),
        64.0,
    )
    _, _, consumer_base, _, consumer_power = _group_layout(*args)
    _, _, provider_base, _, provider_power = _group_layout(
        *args,
        apply_effective_sample_cap=False,
    )

    assert np.sum(consumer_base) == pytest.approx(40.96)
    assert np.sum(provider_base) == pytest.approx(64.0)
    assert consumer_power[0] == pytest.approx(0.4096)
    assert provider_power[0] == pytest.approx(0.64)


def test_prior_aware_update_receives_provider_final_group_power() -> None:
    result = update_prior_aware_gauge_belief(
        _provider_batch(100, 64.0),
        config=PriorAwareGaugeConfigV1(
            minimum_conditional_information_fraction=0.0,
            minimum_identifiable_fraction=0.01,
            minimum_query_sensitivity_fraction=0.0,
        ),
    )

    assert result.diagnostics[
        "provider_owns_observation_effective_sample_cap"
    ] is True
    assert result.diagnostics["observation_group_power"][0] == pytest.approx(0.64)


def test_observation_adapter_propagates_provider_ownership() -> None:
    belief = ObservationBeliefV1(
        case_id="case",
        stream_id="prob4d:test",
        causal_frame_stop=2,
        view_names=("camera0",),
        window_names=("window0",),
        factor_names=(),
        source_repository="FlorianPfaff/Prob4D",
        source_revision="a" * 40,
        source_artifact_sha256="b" * 64,
        declared_frame_ids=np.asarray([0]),
        mean_xyz_m=np.asarray([[0.0, 0.0, 1.0]]),
        frame_ids=np.asarray([0]),
        entity_ids=np.asarray([0]),
        view_indices=np.asarray([0]),
        window_indices=np.asarray([0]),
        correlation_group_ids=np.asarray([0]),
        factor_group_ids=np.asarray([0]),
        prior_reliability=np.asarray([1.0]),
        association_probability=np.asarray([1.0]),
        local_covariance_m2=np.asarray([np.eye(3)]),
        low_rank_factor_m=np.empty((1, 3, 0)),
        group_ids=np.asarray([0]),
        group_prior_nominal_probability=np.asarray([1.0]),
        group_composite_weight=np.asarray([1.0]),
        metadata={
            "group_composite_weight_semantics": (
                PROVIDER_FINAL_COMPOSITE_WEIGHT_SEMANTICS
            ),
            "correlation_group_information": {
                "semantics": PROVIDER_FINAL_COMPOSITE_WEIGHT_SEMANTICS,
                "provider_owns_effective_sample_cap": True,
            },
        },
    )
    state = np.zeros((1, 3, 1), dtype=np.float64)
    state[:, 0, 0] = 1.0

    adapted = build_gauge_aware_batch_from_observation_belief(
        belief,
        physical_prediction_xyz_m=np.zeros((1, 3)),
        state_jacobian=state,
        query_state_jacobian=state,
        physical_response_scale_m=1.0,
    )

    assert adapted.batch.metadata[
        "group_composite_weight_semantics"
    ] == PROVIDER_FINAL_COMPOSITE_WEIGHT_SEMANTICS
    assert adapted.batch.metadata["provider_owns_effective_sample_cap"] is True
    assert adapted.summary()["provider_owns_effective_sample_cap"] is True


def test_provider_owned_unknown_semantics_fail_closed() -> None:
    with pytest.raises(ValueError, match="unknown semantics"):
        provider_owns_effective_sample_cap(
            {
                "group_composite_weight_semantics": "unknown-v9",
                "provider_owns_effective_sample_cap": True,
            }
        )
''',
)

