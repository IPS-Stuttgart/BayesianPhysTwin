{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ips-stuttgart.github.io/BayesianPhysTwin/contracts/evidence-decision-v2.schema.json",
  "title": "Bayesian-PhysTwin evidence decision v2",
  "description": "Content-addressed evidence decision with orthogonal execution, scientific, and authorization outcomes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "schema_name",
    "schema_version",
    "created_utc",
    "claim_id",
    "protocol_id",
    "execution_status",
    "scientific_decision",
    "authorization",
    "run_classification",
    "evidence_level",
    "metric",
    "run_manifest_id",
    "evidence_fingerprint",
    "evidence_summary_sha256",
    "repositories",
    "limitations",
    "metadata"
  ],
  "properties": {
    "decision_id": {
      "$ref": "#/$defs/sha256"
    },
    "schema_name": {
      "const": "bayesian_phystwin.evidence_decision"
    },
    "schema_version": {
      "const": 2
    },
    "created_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|\\+00:00)$"
    },
    "claim_id": {
      "$ref": "#/$defs/canonicalText"
    },
    "protocol_id": {
      "$ref": "#/$defs/canonicalText"
    },
    "execution_status": {
      "enum": [
        "completed",
        "infrastructure_failure",
        "protocol_invalid"
      ]
    },
    "scientific_decision": {
      "enum": [
        "pass",
        "negative",
        "not_evaluated"
      ]
    },
    "authorization": {
      "enum": [
        "advance",
        "stop"
      ]
    },
    "run_classification": {
      "enum": [
        "controlled",
        "exploratory",
        "confirmatory",
        "diagnostic",
        "infrastructure"
      ]
    },
    "evidence_level": {
      "enum": [
        1,
        2,
        3
      ]
    },
    "metric": {
      "oneOf": [
        {
          "$ref": "#/$defs/metric"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_manifest_id": {
      "$ref": "#/$defs/sha256"
    },
    "evidence_fingerprint": {
      "$ref": "#/$defs/sha256"
    },
    "evidence_summary_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/repository"
      },
      "contains": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "const": "primary"
          }
        }
      },
      "minContains": 1,
      "maxContains": 1
    },
    "limitations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/canonicalText"
      }
    },
    "metadata": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "execution_status": {
            "enum": [
              "infrastructure_failure",
              "protocol_invalid"
            ]
          }
        },
        "required": [
          "execution_status"
        ]
      },
      "then": {
        "properties": {
          "scientific_decision": {
            "const": "not_evaluated"
          },
          "authorization": {
            "const": "stop"
          },
          "metric": {
            "type": "null"
          },
          "limitations": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scientific_decision": {
            "enum": [
              "pass",
              "negative"
            ]
          }
        },
        "required": [
          "scientific_decision"
        ]
      },
      "then": {
        "properties": {
          "metric": {
            "$ref": "#/$defs/metric"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scientific_decision": {
            "const": "not_evaluated"
          }
        },
        "required": [
          "scientific_decision"
        ]
      },
      "then": {
        "properties": {
          "authorization": {
            "const": "stop"
          },
          "metric": {
            "type": "null"
          },
          "limitations": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scientific_decision": {
            "const": "negative"
          }
        },
        "required": [
          "scientific_decision"
        ]
      },
      "then": {
        "properties": {
          "authorization": {
            "const": "stop"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authorization": {
            "const": "advance"
          }
        },
        "required": [
          "authorization"
        ]
      },
      "then": {
        "properties": {
          "execution_status": {
            "const": "completed"
          },
          "scientific_decision": {
            "const": "pass"
          },
          "run_classification": {
            "const": "confirmatory"
          },
          "repositories": {
            "items": {
              "properties": {
                "dirty": {
                  "const": false
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "scientific_decision": {
            "const": "pass"
          },
          "authorization": {
            "const": "stop"
          }
        },
        "required": [
          "scientific_decision",
          "authorization"
        ]
      },
      "then": {
        "properties": {
          "limitations": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "canonicalText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "comparison",
        "rule",
        "observed_value",
        "threshold_value",
        "unit"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/canonicalText"
        },
        "comparison": {
          "$ref": "#/$defs/canonicalText"
        },
        "rule": {
          "$ref": "#/$defs/canonicalText"
        },
        "observed_value": {
          "type": "number"
        },
        "threshold_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "$ref": "#/$defs/canonicalText"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "revision",
        "dirty",
        "role"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[^/\\s]+/[^/\\s]+$"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty": {
          "type": "boolean"
        },
        "role": {
          "enum": [
            "primary",
            "upstream",
            "observation",
            "downstream",
            "paper",
            "environment",
            "dependency"
          ]
        }
      }
    }
  }
}
