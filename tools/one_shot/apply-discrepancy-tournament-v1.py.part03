def replace_once(path: str, old: str, new: str) -> None:
    target = ROOT / path
    text = target.read_text(encoding="utf-8")
    count = text.count(old)
    if count != 1:
        raise SystemExit(f"{path}: expected one marker, found {count}")
    target.write_text(text.replace(old, new), encoding="utf-8")


def extract_payload() -> None:
    payload = base64.b64decode(ARCHIVE)
    with tarfile.open(fileobj=io.BytesIO(payload), mode="r:gz") as archive:
        members = archive.getmembers()
        names = {member.name for member in members}
        if names != EXPECTED:
            raise SystemExit(f"payload roster changed: {sorted(names ^ EXPECTED)}")
        for member in members:
            unsafe = (
                not member.isfile()
                or member.name.startswith("/")
                or ".." in Path(member.name).parts
            )
            if unsafe:
                raise SystemExit(f"unsafe payload member: {member.name}")
            source = archive.extractfile(member)
            if source is None:
                raise SystemExit(f"payload member has no bytes: {member.name}")
            destination = ROOT / member.name
            destination.parent.mkdir(parents=True, exist_ok=True)
            destination.write_bytes(source.read())


def patch_files() -> None:
    replace_once('src/bayesian_phystwin/cli/experiments.py', '    "diagnose-provider-failures": (\n        "bayesian_phystwin.cli.provider_failure_decomposition"\n    ),\n', '    "diagnose-pr