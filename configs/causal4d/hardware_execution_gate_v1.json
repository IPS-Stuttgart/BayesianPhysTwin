{
  "schema_version": 1,
  "protocol_id": "causal4d-hardware-execution-gate-v1",
  "nominal_coverage": 0.9,
  "required_before_physical_closed_loop": {
    "minimum_independent_calibration_executions": 10,
    "minimum_target_coordinate_coverage": 0.85,
    "minimum_worst_group_coverage": 0.8,
    "source_only_calibration_frozen_before_target": true,
    "closed_loop_state_handoff_tests_pass": true,
    "constraint_rejection_tests_pass": true,
    "replay_variance_included_in_predictive_risk": true,
    "emergency_stop_and_workspace_limits_registered": true
  },
  "semantic_branch": {
    "optional": true,
    "beta_zero_does_not_block_hardware": true,
    "positive_beta_requires_molmo_acceptance": true,
    "molmo_acceptance_protocol": "causal4d-molmo-acceptance-v1",
    "freshness_gate": {
      "required_for_positive_beta": true,
      "runtime_timing_schema_version": 1,
      "clock": "monotonic",
      "shared_clock_id_required": true,
      "expected_clock_id_source": "trusted_planner_runtime_context_not_semantic_timing_payload",
      "reject_if_reported_clock_id_mismatches_expected": true,
      "generation_timing_scope": "semantic_generation_start_to_task_posterior_materialized",
      "query_timestamp_definition": "observation_and_query_snapshot_capture",
      "current_timestamp_definition": "freshness_gate_evaluation_before_planner_handoff",
      "planning_deadline_timestamp_definition": "latest_safe_planner_handoff_on_the_same_monotonic_clock",
      "limits": {
        "schema_version": 1,
        "max_inference_duration_s": 1.0,
        "max_forecast_age_s": 2.0
      },
      "planning_deadline_required_per_query": true,
      "reject_if_current_time_exceeds_planning_deadline": true,
      "malformed_timing_fails_closed": true,
      "fallback": {
        "beta": 0.0,
        "preserve_physical_weights_bit_for_bit": true,
        "semantic_branch_must_not_block_hardware": true
      }
    }
  },
  "first_authorized_experiment": {
    "objects": 1,
    "grippers": 1,
    "initial_grasp": "known_and_fixed",
    "candidate_action_count_maximum": 4,
    "receding_horizon": "short",
    "induced_errors": [
      "one_gain_or_delay_error",
      "one_mid_execution_perturbation"
    ],
    "required_comparisons": [
      "nominal_phystwin",
      "bayesian_phystwin",
      "causal4d_closed_loop"
    ],
    "required_metrics": [
      "task_success",
      "constraint_violations",
      "replanning_count",
      "predictive_coverage",
      "final_configuration_error",
      "control_effort",
      "perturbation_recovery"
    ]
  }
}
